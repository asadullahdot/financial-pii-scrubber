# Copy this file to .env and fill in your own values. .env is never committed.
GROQ_API_KEY=your_groq_api_key_here
DATABASE_URL=postgresql+psycopg://pii:pii_pass@localhost:5432/pii_scrubber

# Optional
# GROQ_MODEL=openai/gpt-oss-120b      # default; set another model if your quota is used up
# ANALYSIS_MODE=hybrid                # hybrid (default) | llm | local
# GROQ_WORKERS=2                      # parallel Groq calls
